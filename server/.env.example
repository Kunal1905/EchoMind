# ── Server env template ──────────────────────────────────────────────
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
# Render: set these as Environment variables in the service dashboard, then redeploy.

# Core
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
DATABASE_URL=postgres://user:pass@host/db
DATABASE_URL_POOLED=postgres://user:pass@host/db-pooled

# Auth / Clerk
CLERK_WEBHOOK_SECRET=whsec_xxx
CLIENT_ORIGIN=http://localhost:3000
# Comma-separated allowed origins if used
CLIENT_ORIGINS=http://localhost:3000

# Vapi
VAPI_WEBHOOK_SECRET=whsec_xxx

# Google Gemini (assistant LLM)
GEMINI_API_KEY=xxx

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Razorpay (billing)
RAZORPAY_KEY_ID=xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx

# PostHog (analytics)
POSTHOG_API_KEY=xxx

# Sentry (server error monitoring)
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=development
# Set temporarily to verify /debug-sentry, then remove it after verification.
SENTRY_TEST_TOKEN=replace-with-a-long-random-value

# Queue
QUEUE_SECRET=xxx

# ── REQUIRED: Vapi dashboard assistant ────────────────────────────────
# The assistant ID from your Vapi dashboard. The call runs through this
# assistant (voice/STT/LLM configured there — e.g. ElevenLabs Bella +
# multilingual v2); the server only injects dynamic overrides (duration,
# memory, language, webhook). Without this, no calls can start.
VAPI_VOICE_ASSISTANT_ID=xxx
